{
  "name": "dsh-message-actions",
  "version": "0.2.11",
  "description": "功能：撤回、删除、删至末尾、多选分享与导出，会话管理（回收站、恢复、移动到其他工作区），每条回答的用量计费、余额费用展示、对话完成声音提示等。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aijacko/dsh-message-actions.git"
  },
  "homepage": "https://github.com/aijacko/dsh-message-actions#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/check.mjs",
    "prepack": "node build.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/shared.cjs",
    "lib/store.cjs",
    "lib/http.cjs",
    "lib/sessions.cjs",
    "lib/session-manager.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}